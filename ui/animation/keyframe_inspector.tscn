[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/animation/keyframe_inspector.gd" id="1"]

[node name="KeyframeInspector" type="PanelContainer"]
custom_minimum_size = Vector2(230, 0)
theme_type_variation = &"SidebarPanel"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]

[node name="Title" type="Label" parent="Margin/Layout/Header"]
text = "KEYFRAME"
size_flags_horizontal = 3
theme_type_variation = &"SectionHeading"

[node name="Close" type="Button" parent="Margin/Layout/Header"]
unique_name_in_owner = true
theme_type_variation = &"TransportButton"
text = "×"
tooltip_text = "Close keyframe inspector"

[node name="ShapeName" type="OptionButton" parent="Margin/Layout"]
unique_name_in_owner = true
fit_to_longest_item = false
clip_text = true
theme_override_font_sizes/font_size = 13

[node name="FrameLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 12

[node name="Scroll" type="ScrollContainer" parent="Margin/Layout"]
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Fields" type="VBoxContainer" parent="Margin/Layout/Scroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 2
